{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "description": { "$ref": "types.json#/$defs/string-or-null"},
    "members": {
      "type": "array",
      "items": { "type": "string" }
    },
    "privacy": { "type": "string", "enum": ["secret", "visible"] },
    "notifications": { "type": "boolean" },
    "team_sync": {
      "type": "array",
      "items": { "$ref": "team-sync.json" }
    },
    "external_group_id": { "$ref": "types.json#/$defs/integer-or-null" },
    "skip_members": { "type": "boolean" },
    "skip_non_organization_members": { "type": "boolean" }
  },

  "required": [ "name", "privacy" ],
  "additionalProperties": false
}
