{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "type": "object",
  "properties": {
    "allowed_actions": { "type": "string", "enum": ["all", "local_only", "selected"] },
    "allow_github_owned_actions": { "type": "boolean" },
    "allow_verified_creator_actions": { "type": "boolean" },
    "allow_action_patterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "default_workflow_permissions": { "type": "string", "enum": ["read", "write"] },
    "actions_can_approve_pull_request_reviews": { "type": "boolean" },
    "fork_pr_approval_policy": { "type": "string", "enum": ["first_time_contributors_new_to_github", "first_time_contributors", "all_external_contributors"] },
    "max_cache_size_gb": { "type": ["integer", "null"] }
  }
}
